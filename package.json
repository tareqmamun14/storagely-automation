{
  "name": "storagely-automation",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:ui": "npx playwright test --ui",
    "test:headed": "npx playwright test --headed",
    "test:debug": "npx playwright test --debug",
    "test:allure-only": "npx playwright test --reporter=allure-playwright",
    "allure:generate": "npx allure generate allure-results --clean -o docs",
    "allure:open": "npx allure open docs",
    "allure:serve": "npx allure serve allure-results",
    "allure:clean": "rmdir /s /q allure-results 2>nul & rmdir /s /q docs 2>nul & echo Cleaned allure directories",
    "deploy:only": "node deploy-only.js",
    "test:deploy": "npm run test:allure-only && npm run allure:generate && node quick-deploy.js",
    "test:allure:serve": "npm run test:allure-only && npm run allure:serve",
    "test:ci": "npx playwright test --reporter=allure-playwright,html,junit",
    "panel": "node control-panel/server.js",
    "run:v1":       "npx playwright test tests/rentReserveV1-validation.spec.ts",
    "run:spc":      "npx playwright test tests/rentReserveSPC-validation.spec.ts",
    "run:uic":      "npx playwright test tests/uiComponents-validation.spec.ts",
    "run:admin":    "npx playwright test tests/adminPlatform-validation.spec.ts",
    "run:datasync": "npx playwright test tests/data-sync-validation.spec.ts",
    "run:minimallrent": "npx playwright test tests/miniMallRental.spec.ts --headed",
    "run:minimall": "npx playwright test tests/miniMallFullScan.spec.ts --project=chrome",
    "run:allpages": "npx playwright test tests/allLocationsScan.spec.ts --project=chrome",
    "run:helix":          "npx playwright test --config=helix/playwright.config.ts --headed",
    "run:helix:live":     "npx playwright test --config=helix/playwright.config.ts --project=live",
    "run:helix:editor":   "npx playwright test --config=helix/playwright.config.ts --project=editor",
    "run:helix:e2e":      "npx playwright test --config=helix/playwright.config.ts --project=live tests/e2e/",
    "run:helix:health":   "npx playwright test --config=helix/playwright.config.ts --project=live tests/live/",
    "run:helix:sections":      "npx playwright test --config=helix/playwright.config.ts --project=live --grep \"Helix . All Sections\"",
    "run:helix:sections:each": "npx playwright test --config=helix/playwright.config.ts --project=live --grep \"Section:\"",
    "run:helix:visual":         "npx playwright test --config=helix/playwright.config.ts --project=live --grep \"Visual baseline\"",
    "run:helix:visual:update":  "npx playwright test --config=helix/playwright.config.ts --project=live --grep \"Visual baseline\" --update-snapshots"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^20.17.32",
    "allure-commandline": "^2.25.0",
    "allure-playwright": "^2.10.0"
  }
}
